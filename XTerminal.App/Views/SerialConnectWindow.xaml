<Window x:Class="XTerminal.App.Views.SerialConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial Session" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        ResizeMode="NoResize">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource CompactBtn}" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" Margin="0,0,8,0" />
      <Button Style="{StaticResource CompactBtnPrimary}" Content="Connect" IsDefault="True" Click="Connect_OnClick" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Serial Console" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
        <TextBlock Text="Open a COM port with validated line settings. The port opens only when you connect."
                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Text="Profile name" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Text="Serial" Padding="8,6" Margin="0,0,0,10"
                 Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="COM port" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <ComboBox x:Name="PortBox" IsEditable="True" Padding="6,4"
                      Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource CompactBtn}" Content="Refresh" Margin="8,18,0,0"
                  VerticalAlignment="Bottom" Click="Refresh_OnClick" />
        </Grid>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <TextBlock Text="Baud rate" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <ComboBox x:Name="BaudBox" IsEditable="True" Padding="6,4"
                      Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Text="Data bits" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <ComboBox x:Name="DataBitsBox" Padding="6,4"
                      Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <TextBlock Text="Parity" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <ComboBox x:Name="ParityBox" Padding="6,4"
                      Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Text="Stop bits" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <ComboBox x:Name="StopBitsBox" Padding="6,4"
                      Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Flow control" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <ComboBox x:Name="FlowBox" Padding="6,4" Margin="0,0,0,10"
                  Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <TextBlock Text="Encoding" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <ComboBox x:Name="EncodingBox" IsEditable="True" Padding="6,4"
                      Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Text="Line ending" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <ComboBox x:Name="LineEndingBox" Padding="6,4"
                      Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
        </Grid>

        <CheckBox x:Name="LocalEchoBox" Content="Local echo (off by default — avoid duplicates if the device echoes)"
                  Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
        <CheckBox x:Name="DtrBox" Content="Assert DTR on open" IsChecked="True"
                  Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
        <CheckBox x:Name="RtsBox" Content="Assert RTS on open" IsChecked="True"
                  Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
        <TextBlock Text="Changing DTR/RTS can reset some embedded devices."
                   FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <CheckBox x:Name="SaveBox" Content="Save as profile" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
        <TextBlock x:Name="ErrorText" Foreground="#FFEF9A9A" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
