<UserControl x:Class="XTerminal.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XTerminal.App.ViewModels"
             xmlns:conv="clr-namespace:XTerminal.App.Converters"
             Background="{DynamicResource BrushAppBackground}"
             PreviewKeyDown="View_OnPreviewKeyDown">
  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
  </UserControl.Resources>

  <Grid Margin="10,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,8" Height="34">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource CompactBtnPrimary}" Content="+ New Session" Command="{Binding NewSessionCommand}" />
        <Button Style="{StaticResource CompactBtn}" Content="New Folder" Command="{Binding NewFolderCommand}" />
        <Button Style="{StaticResource CompactBtn}" Content="Import" Click="Import_OnClick" />
        <Button Style="{StaticResource CompactBtn}" Content="Export" Click="Export_OnClick" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Style="{StaticResource PageTitle}" Text="SSH Sessions" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Credentials stay in Windows Credential Manager — never in session JSON." />
      </StackPanel>
    </DockPanel>

    <!-- Search / filters -->
    <DockPanel Grid.Row="1" Margin="0,0,0,8" Height="32">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <ToggleButton Content="Favorites" IsChecked="{Binding FavoritesOnly}" Height="28" Padding="10,0"
                      Margin="0,0,4,0" Cursor="Hand" FontSize="12"
                      Background="{DynamicResource BrushSurfaceElevated}"
                      Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        <ToggleButton Content="Recent" IsChecked="{Binding RecentOnly}" Height="28" Padding="10,0"
                      Cursor="Hand" FontSize="12"
                      Background="{DynamicResource BrushSurfaceElevated}"
                      Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSoft}" />
      </StackPanel>
      <Border CornerRadius="6" Padding="8,0" Height="28" VerticalAlignment="Center"
              Background="{DynamicResource BrushSurfaceElevated}"
              BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                 VerticalContentAlignment="Center" Background="Transparent"
                 Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccent}"
                 FontSize="12" />
      </Border>
    </DockPanel>

    <!-- Two-pane body -->
    <Grid Grid.Row="2" Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="180" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource BrushSurface}"
              BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Folders" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushTextMuted}" Margin="10,8,10,4" />
          <TreeView x:Name="SessionTree" ItemsSource="{Binding Roots}" BorderThickness="0"
                    Background="Transparent" Padding="4" FontSize="12"
                    SelectedItemChanged="Tree_OnSelectedItemChanged"
                    MouseDoubleClick="Tree_OnMouseDoubleClick">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate DataType="{x:Type vm:SessionTreeNode}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="8,0,0,0"
                             Foreground="{DynamicResource BrushTextMuted}" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource BrushSurface}"
              BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="8,6" Height="28">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource CompactBtnPrimary}" Content="Connect" Command="{Binding ConnectCommand}"
                      CommandParameter="{Binding SelectedSession}" ToolTip="Connect (Enter)" />
              <Button Style="{StaticResource CompactBtn}" Content="SFTP" Command="{Binding OpenSftpCommand}"
                      CommandParameter="{Binding SelectedSession}" />
              <Button Style="{StaticResource CompactBtn}" Content="Edit" Command="{Binding EditSessionCommand}"
                      CommandParameter="{Binding SelectedSession}" />
              <Button Style="{StaticResource CompactBtn}" Content="★" ToolTip="Favorite"
                      Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedSession}" />
              <Button Style="{StaticResource CompactBtn}" Content="Duplicate"
                      Command="{Binding DuplicateSessionCommand}" CommandParameter="{Binding SelectedSession}" />
              <Button Style="{StaticResource CompactBtn}" Content="Export" Command="{Binding ExportSessionsCommand}"
                      ToolTip="Export sessions without secrets" />
              <Button Style="{StaticResource CompactBtn}" Content="Import" Command="{Binding ImportSessionsCommand}" />
              <Button Style="{StaticResource CompactBtnDanger}" Content="Delete" Click="Delete_OnClick" />
            </StackPanel>
            <TextBlock Text="Sessions" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextMuted}" />
          </DockPanel>

          <DataGrid ItemsSource="{Binding FlatSessions}" SelectedItem="{Binding SelectedSession}"
                    Style="{StaticResource DesktopDataGrid}"
                    ColumnHeaderStyle="{StaticResource DesktopColumnHeader}"
                    RowStyle="{StaticResource DesktopDataGridRow}"
                    CellStyle="{StaticResource DesktopDataGridCell}"
                    MouseDoubleClick="Grid_OnMouseDoubleClick"
                    ContextMenuOpening="Grid_OnContextMenuOpening">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Connect" Click="CtxConnect_OnClick" />
                <MenuItem Header="Open SFTP" Click="CtxSftp_OnClick" />
                <Separator />
                <MenuItem Header="Edit" Click="CtxEdit_OnClick" />
                <MenuItem Header="Duplicate" Click="CtxDup_OnClick" />
                <MenuItem Header="Rename" Click="CtxRename_OnClick" />
                <MenuItem Header="Favorite" Click="CtxFav_OnClick" />
                <MenuItem Header="Move to folder…" Click="CtxMove_OnClick" />
                <MenuItem Header="Copy host" Click="CtxCopy_OnClick" />
                <Separator />
                <MenuItem Header="Delete" Click="Delete_OnClick" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="120" />
              <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="140" />
              <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="56" />
              <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100" />
              <DataGridCheckBoxColumn Header="★" Binding="{Binding IsFavorite, Mode=OneWay}" Width="40" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Empty state -->
    <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1"
            Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisInvert}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No SSH sessions yet" />
        <TextBlock Style="{StaticResource EmptyStateSubtitle}"
                   Text="Create a saved connection to get started. Secrets are stored in Windows Credential Manager." />
        <Button Style="{StaticResource CompactBtnPrimary}" Content="New SSH Session"
                Command="{Binding NewSessionCommand}" HorizontalAlignment="Center" Height="30" Padding="14,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
