<Window x:Class="XTerminal.App.Views.RdpConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RDP Session" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        ResizeMode="NoResize">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource CompactBtn}" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" Margin="0,0,8,0" />
      <Button Style="{StaticResource CompactBtnPrimary}" Content="Connect" IsDefault="True" Click="Connect_OnClick" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Remote Desktop (RDP)" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
        <TextBlock Text="Embedded Microsoft RDP ActiveX. Credentials are stored only in Windows Credential Manager when requested."
                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Text="Profile name" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Text="RDP" Padding="8,6" Margin="0,0,0,10"
                 Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Host" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <TextBox x:Name="HostBox" Padding="8,6"
                     Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Port" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <TextBox x:Name="PortBox" Text="3389" Padding="8,6"
                     Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <TextBlock Text="Username" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <TextBox x:Name="UserBox" Padding="8,6"
                     Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Text="Domain" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <TextBox x:Name="DomainBox" Padding="8,6"
                     Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Password" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBox" Padding="8,6" Margin="0,0,0,8"
                     Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        <CheckBox x:Name="RememberBox" Content="Remember password (Credential Manager)"
                  Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10" />

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <TextBlock Text="Width" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <TextBox x:Name="WidthBox" Text="1280" Padding="8,6"
                     Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,6,0">
            <TextBlock Text="Height" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <TextBox x:Name="HeightBox" Text="720" Padding="8,6"
                     Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="6,0,0,0">
            <TextBlock Text="Color depth" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
            <ComboBox x:Name="DepthBox" Padding="6,4"
                      Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
          </StackPanel>
        </Grid>

        <CheckBox x:Name="NlaBox" Content="Require NLA / CredSSP (recommended)" IsChecked="True"
                  Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
        <CheckBox x:Name="SmartSizeBox" Content="Smart sizing" IsChecked="True"
                  Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
        <TextBlock Text="Redirection (off by default — may expose local resources)"
                   FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <CheckBox x:Name="ClipBox" Content="Clipboard" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,2" />
        <CheckBox x:Name="DriveBox" Content="Drives" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,2" />
        <CheckBox x:Name="PrinterBox" Content="Printers" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,2" />
        <CheckBox x:Name="AudioBox" Content="Audio" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
        <CheckBox x:Name="SaveBox" Content="Save as profile" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
        <TextBlock x:Name="ErrorText" Foreground="#FFEF9A9A" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
