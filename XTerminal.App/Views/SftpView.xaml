<UserControl x:Class="XTerminal.App.Views.SftpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XTerminal.App.ViewModels"
             xmlns:conv="clr-namespace:XTerminal.App.Converters"
             Background="{DynamicResource BrushAppBackground}">
  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
  </UserControl.Resources>

  <Grid Margin="10,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Connection bar -->
    <DockPanel Grid.Row="0" Margin="0,0,0,6" Height="34">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource CompactBtn}" Content="Open Session" Click="OpenSession_OnClick"
                ToolTip="Pick an SSH session for SFTP" />
        <Button Style="{StaticResource CompactBtn}" Content="Disconnect" Click="Disconnect_OnClick"
                IsEnabled="{Binding IsConnected}" ToolTip="Disconnect SFTP" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Style="{StaticResource PageTitle}" Text="SFTP" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding SessionLabel}" />
      </StackPanel>
    </DockPanel>

    <!-- Toolbar + path -->
    <DockPanel Grid.Row="1" Margin="0,0,0,6" Height="32">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
        <Button Style="{StaticResource CompactIconBtn}" Content="←" ToolTip="Back"
                Command="{Binding GoBackCommand}" IsEnabled="{Binding IsConnected}" />
        <Button Style="{StaticResource CompactIconBtn}" Content="→" ToolTip="Forward"
                Command="{Binding GoForwardCommand}" IsEnabled="{Binding IsConnected}" />
        <Button Style="{StaticResource CompactIconBtn}" Content="↑" ToolTip="Parent"
                Command="{Binding GoParentCommand}" IsEnabled="{Binding IsConnected}" />
        <Button Style="{StaticResource CompactBtn}" Content="Home" Command="{Binding GoHomeCommand}"
                IsEnabled="{Binding IsConnected}" />
        <Button Style="{StaticResource CompactBtn}" Content="Refresh" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsConnected}" />
        <Button Style="{StaticResource CompactBtn}" Content="Upload" Command="{Binding UploadFileCommand}"
                IsEnabled="{Binding IsConnected}" />
        <Button Style="{StaticResource CompactBtn}" Content="Download" Command="{Binding DownloadCommand}"
                IsEnabled="{Binding IsConnected}" />
        <Button Style="{StaticResource CompactBtn}" Content="New File" Command="{Binding CreateFileCommand}"
                IsEnabled="{Binding IsConnected}" />
        <Button Style="{StaticResource CompactBtn}" Content="New Folder" Command="{Binding CreateFolderCommand}"
                IsEnabled="{Binding IsConnected}" />
        <Button Style="{StaticResource CompactBtn}" Content="Edit" Command="{Binding OpenInEditorCommand}"
                IsEnabled="{Binding IsConnected}" />
      </StackPanel>
      <DockPanel Margin="8,0,0,0" IsEnabled="{Binding IsConnected}">
        <Button DockPanel.Dock="Right" Style="{StaticResource CompactBtn}" Content="Go"
                Command="{Binding NavigateTypedPathCommand}" Margin="4,0,0,0" />
        <Border CornerRadius="6" Padding="8,0" Height="28" VerticalAlignment="Center"
                Background="{DynamicResource BrushSurfaceElevated}"
                BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1">
          <TextBox Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                   VerticalContentAlignment="Center" Background="Transparent"
                   Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccent}"
                   FontFamily="Consolas" FontSize="12" KeyDown="PathBox_OnKeyDown" />
        </Border>
      </DockPanel>
    </DockPanel>

    <!-- File browser -->
    <Grid Grid.Row="2">
      <Grid Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" MinWidth="140" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Directories" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextMuted}" Margin="10,8,10,4" />
            <TreeView ItemsSource="{Binding TreeRoots}" BorderThickness="0" Background="Transparent"
                      Padding="4" SelectedItemChanged="Tree_OnSelectedItemChanged"
                      TreeViewItem.Expanded="Tree_OnExpanded" FontSize="12"
                      Foreground="{DynamicResource BrushTextPrimary}">
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:SftpTreeNode}" ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding Name}" FontSize="12" />
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Stretch" />

        <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1">
          <DockPanel>
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="8,4,8,0" Height="24">
              <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Label}" Cursor="Hand" Padding="4,1" Margin="0,0,2,0"
                            Background="Transparent" BorderThickness="0" FontSize="11"
                            Foreground="{DynamicResource BrushAccent}"
                            Click="Breadcrumb_OnClick" Tag="{Binding Path}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="10,4"
                       FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                      Style="{StaticResource DesktopDataGrid}"
                      ColumnHeaderStyle="{StaticResource DesktopColumnHeader}"
                      RowStyle="{StaticResource DesktopDataGridRow}"
                      CellStyle="{StaticResource DesktopDataGridCell}"
                      MouseDoubleClick="Grid_OnMouseDoubleClick">
              <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="Open" Command="{Binding OpenEntryCommand}" />
                  <MenuItem Header="Download" Command="{Binding DownloadCommand}" />
                  <MenuItem Header="Open in Editor" Command="{Binding OpenInEditorCommand}" />
                  <Separator />
                  <MenuItem Header="Rename" Command="{Binding RenameCommand}" />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                  <MenuItem Header="Copy Remote Path" Command="{Binding CopyRemotePathCommand}" />
                  <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="" Binding="{Binding TypeGlyph}" Width="32" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80" />
                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="130" />
                <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="90" />
                <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="70" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Disconnected empty state -->
      <Border CornerRadius="8" Background="{DynamicResource BrushSurface}"
              BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1"
              Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisInvert}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="⇅" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,8"
                     Foreground="{DynamicResource BrushAccent}" />
          <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No SFTP connection" />
          <TextBlock Style="{StaticResource EmptyStateSubtitle}"
                     Text="Select an SSH session to browse remote files. Credentials are reused from the saved session." />
          <Button Style="{StaticResource CompactBtnPrimary}" Content="Open Session"
                  Click="OpenSession_OnClick" HorizontalAlignment="Center" Height="30" Padding="14,0" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Error -->
    <Border Grid.Row="3" Margin="0,6,0,0" Padding="8,5" CornerRadius="6"
            Background="#33E81123" BorderBrush="#88E81123" BorderThickness="1"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding ErrorBanner}" Foreground="#FFEF9A9A" FontSize="11" TextWrapping="Wrap" />
    </Border>

    <!-- Transfer manager (collapsible) -->
    <Border Grid.Row="4" Margin="0,6,0,0" CornerRadius="8"
            Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1">
      <Expander IsExpanded="{Binding HasTransfers}" ExpandDirection="Down" Padding="8,4">
        <Expander.Header>
          <DockPanel>
            <TextBlock Text="Transfer Manager" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource CompactBtn}" Content="Cancel" Command="{Binding CancelTransferCommand}"
                      CommandParameter="{Binding SelectedTransfer}" Margin="8,0,0,0"
                      IsEnabled="{Binding SelectedTransfer.CanCancel}"
                      ToolTip="Cancel the selected in-progress transfer" />
              <Button Style="{StaticResource CompactBtn}" Content="Retry" Command="{Binding RetryTransferCommand}"
                      CommandParameter="{Binding SelectedTransfer}"
                      ToolTip="Retry a failed transfer" />
              <Button Style="{StaticResource CompactBtn}" Content="Clear completed"
                      Command="{Binding ClearCompletedTransfersCommand}"
                      ToolTip="Remove finished transfers from the list" />
            </StackPanel>
          </DockPanel>
        </Expander.Header>
        <DataGrid ItemsSource="{Binding Transfers}" SelectedItem="{Binding SelectedTransfer}"
                  Style="{StaticResource DesktopDataGrid}" Height="140" Margin="0,6,0,0"
                  ColumnHeaderStyle="{StaticResource DesktopColumnHeader}"
                  RowStyle="{StaticResource DesktopDataGridRow}"
                  CellStyle="{StaticResource DesktopDataGridCell}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="120" />
            <DataGridTextColumn Header="Dir" Binding="{Binding DirectionLabel}" Width="64" />
            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*" />
            <DataGridTextColumn Header="Progress" Binding="{Binding SizeDisplay}" Width="100" />
            <DataGridTemplateColumn Header="%" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Margin="4,4">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage}" Height="6"
                                 VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedDisplay}" Width="70" />
            <DataGridTextColumn Header="ETA" Binding="{Binding EtaDisplay}" Width="56" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Expander>
    </Border>
  </Grid>
</UserControl>
