<Window x:Class="XTerminal.App.Views.PortForwardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:XTerminal.App.Converters"
        Title="Port Forward" Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="NoResize">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSoft}" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock Text="{Binding ValidationError}" Foreground="#FFEF9A9A" FontSize="11"
                 VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="220" TextWrapping="Wrap" />
      <Button Style="{StaticResource CompactBtn}" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" />
      <Button Style="{StaticResource CompactBtnPrimary}" Content="Save" IsDefault="True" Click="Save_OnClick" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="SSH Session" />
        <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                  DisplayMemberPath="Name" Margin="0,0,0,10" Height="28" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Type" />
        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Margin="0,0,0,10" Height="28" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Bind address" />
        <TextBox Style="{StaticResource FieldBox}" Text="{Binding BindAddress, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Listen / local port" />
        <TextBox Style="{StaticResource FieldBox}" Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Visibility="{Binding ShowDestination, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="Destination host" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding DestinationHost, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="Destination port" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding DestinationPort, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <CheckBox Content="Auto start" IsChecked="{Binding AutoStart}" Margin="0,0,0,6"
                  Foreground="{DynamicResource BrushTextPrimary}" />
        <CheckBox Content="Reconnect with SSH" IsChecked="{Binding ReconnectWithSsh}" Margin="0,0,0,6"
                  Foreground="{DynamicResource BrushTextPrimary}" />
        <CheckBox Content="Allow LAN access (bind 0.0.0.0)" IsChecked="{Binding AllowLan}"
                  Foreground="{DynamicResource BrushTextPrimary}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
