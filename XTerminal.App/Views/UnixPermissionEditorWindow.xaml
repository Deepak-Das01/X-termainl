<Window x:Class="XTerminal.App.Views.UnixPermissionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change permissions"
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}"
        ResizeMode="NoResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{Binding PathDisplay}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextPrimary}" />
      <TextBlock Text="{Binding SymbolicDisplay}" Margin="0,6,0,0" FontFamily="Consolas" FontSize="13"
                 Foreground="{DynamicResource BrushAccent}" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Owner" FontWeight="SemiBold" Margin="0,0,0,6" />
        <CheckBox Content="Read" IsChecked="{Binding OwnerRead}" Margin="0,0,0,4" Checked="Bit_OnChanged" Unchecked="Bit_OnChanged" />
        <CheckBox Content="Write" IsChecked="{Binding OwnerWrite}" Margin="0,0,0,4" Checked="Bit_OnChanged" Unchecked="Bit_OnChanged" />
        <CheckBox Content="Execute" IsChecked="{Binding OwnerExecute}" Checked="Bit_OnChanged" Unchecked="Bit_OnChanged" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,8,0">
        <TextBlock Text="Group" FontWeight="SemiBold" Margin="0,0,0,6" />
        <CheckBox Content="Read" IsChecked="{Binding GroupRead}" Margin="0,0,0,4" Checked="Bit_OnChanged" Unchecked="Bit_OnChanged" />
        <CheckBox Content="Write" IsChecked="{Binding GroupWrite}" Margin="0,0,0,4" Checked="Bit_OnChanged" Unchecked="Bit_OnChanged" />
        <CheckBox Content="Execute" IsChecked="{Binding GroupExecute}" Checked="Bit_OnChanged" Unchecked="Bit_OnChanged" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Others" FontWeight="SemiBold" Margin="0,0,0,6" />
        <CheckBox Content="Read" IsChecked="{Binding OtherRead}" Margin="0,0,0,4" Checked="Bit_OnChanged" Unchecked="Bit_OnChanged" />
        <CheckBox Content="Write" IsChecked="{Binding OtherWrite}" Margin="0,0,0,4" Checked="Bit_OnChanged" Unchecked="Bit_OnChanged" />
        <CheckBox Content="Execute" IsChecked="{Binding OtherExecute}" Checked="Bit_OnChanged" Unchecked="Bit_OnChanged" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,12,0,8">
      <TextBlock Text="Octal" FontWeight="SemiBold" Margin="0,0,0,6" />
      <DockPanel>
        <TextBox x:Name="OctalBox" Width="80" Padding="6,4" Text="{Binding OctalText, UpdateSourceTrigger=PropertyChanged}"
                 LostFocus="OctalBox_OnLostFocus" />
        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                   Text="Presets: 644 755 600 700 775" FontSize="11"
                   Foreground="{DynamicResource BrushTextMuted}" />
      </DockPanel>
      <TextBlock Text="Ownership (chown) is not supported. Special bits are not edited."
                 FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextMuted}" />
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="88" Height="30" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
      <Button Content="Apply" Width="88" Height="30" IsDefault="True" Click="Apply_OnClick"
              Style="{StaticResource CompactBtnPrimary}" />
    </StackPanel>
  </Grid>
</Window>
