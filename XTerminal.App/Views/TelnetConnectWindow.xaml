<Window x:Class="XTerminal.App.Views.TelnetConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telnet Session" Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        ResizeMode="NoResize">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource CompactBtn}" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" Margin="0,0,8,0" />
      <Button Style="{StaticResource CompactBtnPrimary}" Content="Connect" IsDefault="True" Click="Connect_OnClick" />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Telnet Session" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
      <Border Background="#33E8A838" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Text="Telnet is plaintext and unencrypted. Prefer SSH when available. Use only on authorized legacy equipment or lab networks." />
      </Border>

      <TextBlock Text="Profile name" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
      <TextBox x:Name="NameBox" Text="Telnet" Padding="8,6" Margin="0,0,0,10"
               Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="Host" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
          <TextBox x:Name="HostBox" Padding="8,6"
                   Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Port" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
          <TextBox x:Name="PortBox" Text="23" Padding="8,6"
                   Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        </StackPanel>
      </Grid>

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Text="Timeout (seconds)" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
          <TextBox x:Name="TimeoutBox" Text="20" Padding="8,6"
                   Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0">
          <TextBlock Text="Terminal type" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
          <ComboBox x:Name="TermTypeBox" IsEditable="True" Padding="6,4"
                    Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Encoding" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
      <ComboBox x:Name="EncodingBox" IsEditable="True" Padding="6,4" Margin="0,0,0,10"
                Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />

      <CheckBox x:Name="LocalEchoBox" Content="Local echo (usually off — remote ECHO is negotiated)"
                Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
      <CheckBox x:Name="AutoReconnectBox" Content="Allow reconnect for this profile (opt-in)"
                Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
      <CheckBox x:Name="SaveBox" Content="Save as profile" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
      <TextBlock x:Name="ErrorText" Foreground="#FFEF9A9A" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</Window>
