<Window x:Class="XTerminal.App.Views.SnippetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snippet" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="NoResize">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock Text="{Binding ValidationError}" Foreground="#FFEF9A9A" FontSize="11"
                 VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Style="{StaticResource CompactBtn}" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" />
      <Button Style="{StaticResource CompactBtnPrimary}" Content="Save" IsDefault="True" Click="Save_OnClick" />
    </StackPanel>
    <ScrollViewer>
      <StackPanel>
        <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10"
                 Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        <TextBlock Text="Description" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10"
                 Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        <TextBlock Text="Command (use ${host}, ${namespace}, ${file}, ${port})" FontSize="11"
                   Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10"
                 AcceptsReturn="True" Height="90" TextWrapping="Wrap" FontFamily="Consolas"
                 Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        <TextBlock Text="Shell compatibility" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding ShellOptions}" SelectedItem="{Binding ShellCompatibility}" Margin="0,0,0,10" Height="28" />
        <TextBlock Text="Tags" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
        <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10"
                 Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        <CheckBox Content="Favorite" IsChecked="{Binding IsFavorite}" Foreground="{DynamicResource BrushTextPrimary}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
