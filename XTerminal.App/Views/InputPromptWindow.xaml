<Window x:Class="XTerminal.App.Views.InputPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="160" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" Padding="8,5" />
      <Button Content="OK" Width="80" IsDefault="True" Click="Ok_OnClick" Padding="8,5"
              Background="{DynamicResource BrushAccentSoft}" />
    </StackPanel>
    <StackPanel>
      <TextBlock x:Name="PromptText" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />
      <TextBox x:Name="InputBox" Padding="8,6"
               Background="{DynamicResource BrushSurfaceElevated}"
               Foreground="{DynamicResource BrushTextPrimary}"
               CaretBrush="{DynamicResource BrushAccent}"
               BorderBrush="{DynamicResource BrushBorderSoft}" />
    </StackPanel>
  </DockPanel>
</Window>
