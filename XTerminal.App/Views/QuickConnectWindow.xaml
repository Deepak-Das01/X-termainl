<Window x:Class="XTerminal.App.Views.QuickConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Connect" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        ResizeMode="NoResize">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource CompactBtn}" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" />
      <Button Style="{StaticResource CompactBtnPrimary}" Content="Connect" IsDefault="True" Click="Connect_OnClick" />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="SSH Quick Connect" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
      <TextBlock Text="user@host or user@host:port" Style="{StaticResource PageSubtitle}" Margin="0,0,0,12" />
      <TextBlock Text="Target" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
      <TextBox x:Name="TargetBox" Padding="8,6" Margin="0,0,0,10"
               Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}"
               TextChanged="TargetBox_OnTextChanged" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Text="Username" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
          <TextBox x:Name="UserBox" Padding="8,6" Margin="0,0,0,10"
                   Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Port" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
          <TextBox x:Name="PortBox" Text="22" Padding="8,6" Margin="0,0,0,10"
                   Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
        </StackPanel>
      </Grid>
      <TextBlock Text="Password" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
      <PasswordBox x:Name="PasswordBox" Padding="8,6" Margin="0,0,0,10"
                   Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}" />
      <CheckBox x:Name="SaveBox" Content="Save as session" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
      <CheckBox x:Name="RememberBox" Content="Remember password (Credential Manager)" IsChecked="True"
                Foreground="{DynamicResource BrushTextPrimary}" />
      <TextBlock x:Name="ErrorText" Foreground="#FFEF9A9A" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</Window>
