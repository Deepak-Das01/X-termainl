<UserControl x:Class="XTerminal.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XTerminal.App.Converters"
             Background="{DynamicResource BrushAppBackground}">
  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVisInvert" Invert="True" />
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
      <Setter Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource ToolBtn}" Content="Save" Command="{Binding SaveCommand}"
                Background="{DynamicResource BrushAccentSoft}" />
        <Button Style="{StaticResource ToolBtn}" Content="Close" Command="{Binding CloseDocumentCommand}"
                CommandParameter="{Binding SelectedDocument}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Editor" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
      </StackPanel>
    </DockPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
      <ItemsControl ItemsSource="{Binding Documents}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,6,0" CornerRadius="6" Padding="10,5" Cursor="Hand"
                    Background="{DynamicResource BrushSurfaceElevated}"
                    BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1"
                    MouseLeftButtonDown="DocTab_OnClick">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" FontSize="12" />
                <TextBlock Text=" •" Foreground="{DynamicResource BrushAccent}"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" CornerRadius="8"
            Background="{DynamicResource BrushTerminalCanvas}"
            BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1"
            Visibility="{Binding SelectedDocument, Converter={StaticResource NullToVisInvert}}">
      <TextBox Text="{Binding SelectedDocument.Content, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
               AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               FontFamily="Cascadia Mono, Consolas" FontSize="13"
               Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}"
               CaretBrush="{DynamicResource BrushAccent}" BorderThickness="0" Padding="12"
               SpellCheck.IsEnabled="False" />
    </Border>

    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="{Binding SelectedDocument, Converter={StaticResource NullToVis}}">
      <TextBlock Text="No file open" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Open a remote file from the SFTP workspace."
                 Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,0" HorizontalAlignment="Center" />
    </StackPanel>

    <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
               Text="{Binding SelectedDocument.SessionName, StringFormat=Session: {0}}" />
  </Grid>
</UserControl>
