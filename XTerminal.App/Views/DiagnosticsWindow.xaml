<Window x:Class="XTerminal.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Connection Diagnostics"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        ResizeMode="CanResizeWithGrip">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Copy sanitized report" Padding="12,6" Margin="0,0,8,0" Click="Copy_OnClick" />
      <Button Content="Retry" Padding="12,6" Margin="0,0,8,0" Click="Retry_OnClick" IsEnabled="{Binding CanRetry}" />
      <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" Click="Cancel_OnClick" IsEnabled="{Binding IsRunning}" />
      <Button Content="Close" Padding="12,6" IsDefault="True" Click="Close_OnClick" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource BrushTextMuted}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
      <TextBlock Margin="0,8,0,0" Text="{Binding ResultSummary}" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource BrushTextMuted}" Text="{Binding DurationText}" />
      <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"
                 Text="Diagnostics never auto-accept unknown or changed host keys. Passwords and key material are never logged or copied." />
    </StackPanel>

    <ListView ItemsSource="{Binding Steps}" BorderThickness="1"
              BorderBrush="{DynamicResource BrushBorder}"
              Background="Transparent">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Status" Width="70" DisplayMemberBinding="{Binding Status}" />
          <GridViewColumn Header="Stage" Width="110" DisplayMemberBinding="{Binding Phase}" />
          <GridViewColumn Header="Detail" Width="400" DisplayMemberBinding="{Binding Message}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
