<Window x:Class="XTerminal.App.Views.NewSshSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:XTerminal.Core.Models;assembly=XTerminal.Core"
        Title="SSH Session"
        Height="640" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSoft}" />
      <Setter Property="CaretBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style x:Key="ActionBtn" TargetType="Button">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
      <Setter Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Left" Text="{Binding TestResult}" FontSize="11"
                 Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"
                 VerticalAlignment="Center" MaxWidth="420" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource ActionBtn}" Content="Test Connection"
                Command="{Binding TestConnectionCommand}" />
        <Button Style="{StaticResource ActionBtn}" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" />
        <Button Style="{StaticResource ActionBtn}" Content="Save" Click="Save_OnClick" />
        <Button Style="{StaticResource ActionBtn}" Content="Save &amp; Connect" IsDefault="True"
                Click="SaveAndConnect_OnClick" Background="{DynamicResource BrushAccentSoft}" />
      </StackPanel>
    </DockPanel>

    <TabControl SelectedIndex="0" Background="Transparent" BorderThickness="0">
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,0">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Session name" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Host / IP" />
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Username" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Folder" />
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Style="{StaticResource ActionBtn}" Content="+ Folder" Margin="6,0,0,0"
                      Click="CreateFolder_OnClick" Padding="10,6" />
              <ComboBox ItemsSource="{Binding FolderOptions}" SelectedItem="{Binding SelectedFolderOption}"
                        DisplayMemberPath="Name" Height="30" />
            </DockPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Tags (comma separated)" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="Favorite" IsChecked="{Binding IsFavorite}" Foreground="{DynamicResource BrushTextPrimary}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Authentication">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,0">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Authentication method" />
            <ComboBox ItemsSource="{Binding AuthMethods}" SelectedItem="{Binding AuthMethod}" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Password (stored in Windows Credential Manager)" />
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" Padding="8,6"
                         Background="{DynamicResource BrushSurfaceElevated}"
                         Foreground="{DynamicResource BrushTextPrimary}"
                         PasswordChanged="PasswordBox_OnPasswordChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Private key path" />
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="…" Width="36" Style="{StaticResource ActionBtn}" Margin="6,0,0,0" Click="BrowseKey_OnClick" />
              <TextBox Style="{StaticResource FieldBox}" Margin="0" Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Private key passphrase (Credential Manager)" />
            <PasswordBox x:Name="PassphraseBox" Margin="0,0,0,10" Padding="8,6"
                         Background="{DynamicResource BrushSurfaceElevated}"
                         Foreground="{DynamicResource BrushTextPrimary}"
                         PasswordChanged="PassphraseBox_OnPasswordChanged" />
            <TextBlock Text="Leave password/passphrase blank when editing to keep the existing stored secret."
                       FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Advanced">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,0">
          <StackPanel>
            <TextBlock Text="ProxyJump / bastion" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Jump host" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding ProxyJumpHost, UpdateSourceTrigger=PropertyChanged}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Jump username" />
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding ProxyJumpUsername, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Jump port" />
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding ProxyJumpPort, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Jump auth method" />
            <ComboBox ItemsSource="{Binding AuthMethods}" SelectedItem="{Binding ProxyJumpAuthMethod}" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Jump private key path" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding ProxyJumpPrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Jump password (Credential Manager)" />
            <PasswordBox x:Name="JumpPasswordBox" Margin="0,0,0,10" Padding="8,6"
                         Background="{DynamicResource BrushSurfaceElevated}"
                         PasswordChanged="JumpPasswordBox_OnPasswordChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Jump key passphrase (Credential Manager)" />
            <PasswordBox x:Name="JumpPassphraseBox" Margin="0,0,0,10" Padding="8,6"
                         Background="{DynamicResource BrushSurfaceElevated}"
                         PasswordChanged="JumpPassphraseBox_OnPasswordChanged" />
            <CheckBox Content="Strict host key verification" IsChecked="{Binding StrictHostKeyChecking}"
                      Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
            <CheckBox Content="Auto reconnect" IsChecked="{Binding AutoReconnect}"
                      Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Max reconnect attempts" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding MaxReconnectAttempts, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Connection timeout (seconds)" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding ConnectionTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Keepalive interval (seconds)" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding KeepAliveIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="Compression" IsChecked="{Binding Compression}"
                      Foreground="{DynamicResource BrushTextPrimary}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Tunnels">
        <DockPanel Margin="4,10,4,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource ActionBtn}" Content="Add forward" Command="{Binding AddPortForwardCommand}" Margin="0" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding PortForwards}" AutoGenerateColumns="False"
                    CanUserAddRows="False" HeadersVisibility="Column"
                    Background="Transparent" BorderThickness="0"
                    RowBackground="{DynamicResource BrushSurfaceElevated}"
                    Foreground="{DynamicResource BrushTextPrimary}">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40" />
              <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" Width="90"
                                      ItemsSource="{x:Static models:SshForwardTypeValues.All}" />
              <DataGridTextColumn Header="Listen" Binding="{Binding ListenPort}" Width="70" />
              <DataGridTextColumn Header="Bind" Binding="{Binding BindAddress}" Width="100" />
              <DataGridTextColumn Header="Dest host" Binding="{Binding DestinationHost}" Width="*" />
              <DataGridTextColumn Header="Dest port" Binding="{Binding DestinationPort}" Width="80" />
              <DataGridTemplateColumn Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Remove" Style="{StaticResource ActionBtn}" Padding="6,2" Margin="0"
                            Command="{Binding DataContext.RemovePortForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Terminal">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,0">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Terminal type" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding TerminalType, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Startup directory" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding StartupDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Startup command" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding StartupCommand, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Environment variables (KEY=value per line)" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding EnvironmentText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
