<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="AppBackground">#FFF3F3F3</Color>
  <Color x:Key="Surface">#E6FFFFFF</Color>
  <Color x:Key="SurfaceElevated">#FFFFFFFF</Color>
  <Color x:Key="BorderSubtle">#33000000</Color>
  <Color x:Key="BorderSoft">#14000000</Color>
  <Color x:Key="TextPrimary">#FF1A1A1A</Color>
  <Color x:Key="TextMuted">#FF5F6368</Color>
  <Color x:Key="Accent">#FF0078D4</Color>
  <Color x:Key="AccentSoft">#330078D4</Color>
  <Color x:Key="Danger">#FFC42B1C</Color>
  <Color x:Key="Hover">#14000000</Color>
  <Color x:Key="Active">#1F000000</Color>
  <Color x:Key="TerminalCanvas">#FF0C0C0C</Color>
  <Color x:Key="TabActive">#FF0C0C0C</Color>
  <Color x:Key="ActivityBar">#E6F3F3F3</Color>
  <Color x:Key="StatusBar">#E6EEEEEE</Color>
  <Color x:Key="Scrim">#66000000</Color>

  <SolidColorBrush x:Key="BrushAppBackground" Color="{StaticResource AppBackground}" />
  <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource Surface}" />
  <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource SurfaceElevated}" />
  <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource BorderSubtle}" />
  <SolidColorBrush x:Key="BrushBorderSoft" Color="{StaticResource BorderSoft}" />
  <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
  <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" />
  <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource AccentSoft}" />
  <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource Danger}" />
  <SolidColorBrush x:Key="BrushHover" Color="{StaticResource Hover}" />
  <SolidColorBrush x:Key="BrushActive" Color="{StaticResource Active}" />
  <SolidColorBrush x:Key="BrushTerminalCanvas" Color="{StaticResource TerminalCanvas}" />
  <SolidColorBrush x:Key="BrushTabActive" Color="{StaticResource TabActive}" />
  <SolidColorBrush x:Key="BrushTabHover" Color="{StaticResource Hover}" />
  <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource Hover}" />
  <SolidColorBrush x:Key="BrushBgActive" Color="{StaticResource Active}" />
  <SolidColorBrush x:Key="BrushActivityBar" Color="{StaticResource ActivityBar}" />
  <SolidColorBrush x:Key="BrushStatusBar" Color="{StaticResource StatusBar}" />
  <SolidColorBrush x:Key="BrushScrim" Color="{StaticResource Scrim}" />
  <SolidColorBrush x:Key="BrushFlyout" Color="#F7FFFFFF" />
  <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource Surface}" />
</ResourceDictionary>
