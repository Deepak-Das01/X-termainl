<UserControl x:Class="XTerminal.App.Controls.EditorHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource BrushTerminalCanvas}"
             Focusable="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="0,0,0,1" Padding="8,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding DisplayLanguage}" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding Encoding}" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,10,0" />
          <Button Style="{StaticResource CompactIconBtn}" Content="⌕" ToolTip="Find (Ctrl+F)"
                  Click="Find_OnClick" />
          <Button Style="{StaticResource CompactIconBtn}" Content="⇄" ToolTip="Replace (Ctrl+H)"
                  Click="Replace_OnClick" />
          <Button Style="{StaticResource CompactIconBtn}" Content="↵" ToolTip="Go to line (Ctrl+G)"
                  Click="Goto_OnClick" />
          <Button Style="{StaticResource CompactIconBtn}" Content="↩" ToolTip="Toggle wrap (Alt+Z)"
                  Click="Wrap_OnClick" />
          <Button Style="{StaticResource CompactIconBtn}" Content="▥" ToolTip="Toggle minimap"
                  Click="Minimap_OnClick" />
          <Button Style="{StaticResource CompactBtnPrimary}" Content="Save" ToolTip="Save (Ctrl+S)"
                  Click="Save_OnClick" Margin="6,0,0,0" Height="24" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushTextPrimary}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="10,0,0,0"
                     Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#1E1E1E" />
      <Border x:Name="LoadingOverlay" Background="{DynamicResource BrushTerminalCanvas}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Starting editor…" Foreground="{DynamicResource BrushTextMuted}"
                     FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
