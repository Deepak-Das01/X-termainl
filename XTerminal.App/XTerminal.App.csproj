<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon></ApplicationIcon>
    <AssemblyName>XTerminal</AssemblyName>
    <RootNamespace>XTerminal.App</RootNamespace>
    <Product>X-Terminal</Product>
    <Description>Modern native Windows terminal suite</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XTerminal.Core\XTerminal.Core.csproj" />
    <ProjectReference Include="..\XTerminal.Protocols\XTerminal.Protocols.csproj" />
    <ProjectReference Include="..\XTerminal.Terminal\XTerminal.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
