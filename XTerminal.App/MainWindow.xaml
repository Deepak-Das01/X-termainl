<Window x:Class="XTerminal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:XTerminal.App.Controls"
        xmlns:views="clr-namespace:XTerminal.App.Views"
        xmlns:conv="clr-namespace:XTerminal.App.Converters"
        Title="X-Terminal"
        Height="760" Width="1180"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_OnPreviewKeyDown">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="-1"
                        CornerRadius="0"
                        UseAeroCaptionButtons="True" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVisInvert" Invert="True" />
    <conv:StringToBrushConverter x:Key="StringToBrush" />

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActivityBtn" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="4,2" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Accent" Width="2" Height="18" HorizontalAlignment="Left" CornerRadius="1"
                      Background="{DynamicResource BrushAccent}" Opacity="0" Margin="2,0,0,0" />
              <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="4,0,0,0"
                      BorderThickness="1" BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Accent" Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushActive}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SideRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootLayout">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TitleBarRow" Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>

    <!-- TITLE / TAB BAR -->
    <Grid Grid.Row="0" Background="#10FFFFFF" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
      <DockPanel x:Name="TitleBarContent" Margin="0,0,168,0">
        <Border Width="48" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,16,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource IconBtn}" Content="＋" ToolTip="New terminal" Command="{Binding NewPowerShellCommand}" />
          <Button x:Name="ProfileButton" Style="{StaticResource IconBtn}" Content="▾" ToolTip="Profiles / Quick Connect" Click="ProfileButton_OnClick" />
          <Button Style="{StaticResource IconBtn}" Content="⌁" ToolTip="SSH Quick Connect" Command="{Binding QuickConnectCommand}" />
          <Button Style="{StaticResource IconBtn}" Content="✎" ToolTip="New editor tab" Command="{Binding NewUntitledEditorCommand}" />
          <Button Style="{StaticResource IconBtn}" Content="📂" ToolTip="Open file" Command="{Binding OpenLocalFileCommand}" />
          <Button Style="{StaticResource IconBtn}" Content="💾" ToolTip="Save" Command="{Binding SaveEditorCommand}" />
          <Button Style="{StaticResource IconBtn}" Content="◫" ToolTip="Toggle utility panel" Command="{Binding ToggleUtilityPanelCommand}" Margin="4,0,0,0" />
        </StackPanel>

        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="☰" ToolTip="Tab list"
                Click="TabListButton_OnClick" Margin="0,0,4,0" />
        <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
          <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}" AllowDrop="True">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Height="30" Margin="2,5,0,0" CornerRadius="8" Padding="8,0,4,0"
                        Cursor="Hand" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        PreviewMouseLeftButtonDown="Tab_OnPreviewMouseLeftButtonDown"
                        MouseMove="Tab_OnMouseMove"
                        Drop="Tab_OnDrop"
                        AllowDrop="True"
                        MouseDown="Tab_OnMouseDown">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Rename" Click="RenameTab_OnClick" />
                      <MenuItem Header="Pin / Unpin" Click="PinTab_OnClick" />
                      <MenuItem Header="Duplicate" Click="DuplicateTab_OnClick" />
                      <Separator />
                      <MenuItem Header="Close" Click="CloseTabMenu_OnClick" />
                      <MenuItem Header="Close Others" Click="CloseOtherTabs_OnClick" />
                      <MenuItem Header="Close to the Right" Click="CloseTabsToRight_OnClick" />
                      <MenuItem Header="Close Unpinned" Click="CloseUnpinned_OnClick" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="MinWidth" Value="120" />
                      <Setter Property="MaxWidth" Value="200" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                          <Setter Property="MinWidth" Value="48" />
                          <Setter Property="MaxWidth" Value="96" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource BrushTabActive}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{DynamicResource BrushTabHover}" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="20" Height="20" FontSize="10"
                            Content="✕" Opacity="0.6"
                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisInvert}}"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Glyph}" FontSize="11" Margin="0,0,6,0"
                                 Foreground="{Binding Accent, Converter={StaticResource StringToBrush}}" />
                      <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource BrushTextPrimary}" />
                      <TextBlock Text=" ●" FontSize="10" Foreground="{DynamicResource BrushAccent}"
                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Popup x:Name="TabListPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Width="320" MaxHeight="360" CornerRadius="8" Padding="8"
                  Background="{DynamicResource BrushFlyout}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
            <DockPanel>
              <TextBox x:Name="TabListSearch" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,5"
                       Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorderSoft}"
                       TextChanged="TabListSearch_OnTextChanged" />
              <ListBox x:Name="TabListBox" BorderThickness="0" Background="Transparent"
                       MouseDoubleClick="TabListBox_OnMouseDoubleClick" />
            </DockPanel>
          </Border>
        </Popup>
      </DockPanel>

      <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileButton}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True">
        <Border Width="260" Margin="0,4,0,0" CornerRadius="10" Padding="6"
                Background="{DynamicResource BrushFlyout}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
          <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource SideRow}" Click="ProfileItem_OnClick" Tag="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </Popup>
    </Grid>

    <!-- BODY -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- LEFT ACTIVITY BAR -->
      <Border Grid.Column="0" Background="{DynamicResource BrushActivityBar}"
              BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Style="{StaticResource ActivityBtn}" Content="⚙"
                  ToolTip="Settings" Command="{Binding OpenSettingsCommand}" Margin="4,4,4,8" />
          <ItemsControl ItemsSource="{Binding Activities}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource ActivityBtn}"
                        Content="{Binding Glyph}"
                        ToolTip="{Binding ToolTip}"
                        IsEnabled="{Binding IsEnabled}"
                        Command="{Binding DataContext.SelectActivityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- CENTER WORKSPACE -->
      <Grid Grid.Column="1">
        <!-- Workspace: terminal + editor tabs -->
        <Border Background="{DynamicResource BrushTerminalCanvas}"
                Visibility="{Binding IsTerminalView, Converter={StaticResource BoolToVis}}">
          <Grid>
            <controls:TerminalWorkspaceHost x:Name="TerminalView"
                                   DataContext="{Binding SelectedTerminalGroup}"
                                   Visibility="{Binding DataContext.IsTerminalTabSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <controls:EditorHost x:Name="EditorViewHost"
                                 DataContext="{Binding SelectedEditorTab}"
                                 Visibility="{Binding DataContext.IsEditorTabSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding SelectedTab, Converter={StaticResource NullToVis}}">
              <TextBlock Text="No tab open" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="＋ terminal · ✎ editor · 📂 open file"
                         Foreground="{DynamicResource BrushTextMuted}"
                         Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11" />
            </StackPanel>

            <!-- Zoom toast -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                    CornerRadius="6" Padding="12,6" Background="#CC202020"
                    Visibility="{Binding ShowZoomToast, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding ZoomToast}" Foreground="White" FontSize="12" />
            </Border>
          </Grid>
        </Border>

        <!-- Command palette -->
        <Grid Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVis}}"
              Background="#66000000" PreviewMouseLeftButtonDown="OverlayBackdrop_OnClick">
          <Border Width="560" MaxHeight="420" VerticalAlignment="Top" Margin="0,48,0,0"
                  CornerRadius="10" Padding="10"
                  Background="{DynamicResource BrushFlyout}"
                  BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1"
                  PreviewMouseLeftButtonDown="OverlayPanel_OnMouseDown">
            <DockPanel>
              <TextBox x:Name="PaletteInput" DockPanel.Dock="Top" Height="34" Padding="10,6"
                       Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                       Background="{DynamicResource BrushSurfaceElevated}"
                       BorderBrush="{DynamicResource BrushBorderSoft}"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       CaretBrush="{DynamicResource BrushAccent}"
                       KeyDown="PaletteInput_OnKeyDown" />
              <ListBox x:Name="PaletteList" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                       MouseDoubleClick="PaletteList_OnMouseDoubleClick" />
            </DockPanel>
          </Border>
        </Grid>

        <!-- Quick switcher -->
        <Grid Visibility="{Binding IsQuickSwitcherOpen, Converter={StaticResource BoolToVis}}"
              Background="#66000000" PreviewMouseLeftButtonDown="OverlayBackdrop_OnClick">
          <Border Width="560" MaxHeight="420" VerticalAlignment="Top" Margin="0,48,0,0"
                  CornerRadius="10" Padding="10"
                  Background="{DynamicResource BrushFlyout}"
                  BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1"
                  PreviewMouseLeftButtonDown="OverlayPanel_OnMouseDown">
            <DockPanel>
              <TextBox x:Name="SwitcherInput" DockPanel.Dock="Top" Height="34" Padding="10,6"
                       Text="{Binding SwitcherQuery, UpdateSourceTrigger=PropertyChanged}"
                       Background="{DynamicResource BrushSurfaceElevated}"
                       BorderBrush="{DynamicResource BrushBorderSoft}"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       CaretBrush="{DynamicResource BrushAccent}"
                       KeyDown="SwitcherInput_OnKeyDown" />
              <ListBox x:Name="SwitcherList" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                       MouseDoubleClick="SwitcherList_OnMouseDoubleClick" />
            </DockPanel>
          </Border>
        </Grid>

        <!-- Toasts -->
        <ItemsControl ItemsSource="{Binding Notifications.Toasts}" HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" Margin="0,0,16,40">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="300" Margin="0,0,0,8" CornerRadius="8" Padding="12,10"
                      Background="{DynamicResource BrushFlyout}"
                      BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="✕" Width="22" Height="22"
                          Command="{Binding DataContext.Notifications.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource BrushTextMuted}" />
                    <Button Content="{Binding ActionLabel}" Margin="0,8,0,0" Padding="8,3"
                            Visibility="{Binding ActionLabel, Converter={StaticResource NullToVis}}"
                            Command="{Binding DataContext.Notifications.InvokeActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Cursor="Hand" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Settings -->
        <views:SettingsView Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVis}}" />

        <!-- SSH Sessions -->
        <views:SessionsView DataContext="{Binding Sessions}"
                            Visibility="{Binding DataContext.IsSessionsView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <!-- SFTP -->
        <views:SftpView DataContext="{Binding Sftp}"
                        Visibility="{Binding DataContext.IsSftpView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <views:FilesView DataContext="{Binding Files}"
                         Visibility="{Binding DataContext.IsFilesView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <views:PortsView DataContext="{Binding Ports}"
                         Visibility="{Binding DataContext.IsPortsView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <views:SnippetsView DataContext="{Binding Snippets}"
                            Visibility="{Binding DataContext.IsSnippetsView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <views:HistoryView DataContext="{Binding History}"
                           Visibility="{Binding DataContext.IsHistoryView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
      </Grid>

      <!-- RIGHT UTILITY PANEL -->
      <Border Grid.Column="2" Width="300"
              Background="{DynamicResource BrushSurface}"
              BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1,0,0,0"
              Visibility="{Binding IsUtilityPanelOpen, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="12,10,8,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="✕"
                    Command="{Binding ToggleUtilityPanelCommand}" />
            <TextBlock Text="Inspector" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
            <StackPanel>
              <TextBlock Text="Session" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBlock Text="{Binding SelectedTab.Title, FallbackValue=None}" FontSize="13" Margin="0,2,0,10" />
              <TextBlock Text="Status" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBlock Text="{Binding StatusConnection, FallbackValue=Idle}" FontSize="13" Margin="0,2,0,10" />
              <TextBlock Text="Directory" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBlock Text="{Binding StatusDirectory}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12" />

              <TextBlock Text="SFTP Transfers" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,6" />
              <ItemsControl ItemsSource="{Binding Sftp.Transfers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="8" CornerRadius="6"
                            Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1">
                      <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource BrushTextMuted}"
                                   Text="{Binding State, StringFormat={}{0} · }" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource BrushTextMuted}"
                                   Text="{Binding Percentage, StringFormat={}{0:0}%}" />
                        <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding Percentage}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Open SFTP" Margin="0,8,0,0" Padding="10,6" Cursor="Hand"
                      Command="{Binding OpenSftpCommand}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- STATUS BAR -->
    <Border Grid.Row="2" Background="{DynamicResource BrushStatusBar}"
            BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="0,1,0,0" Padding="10,0">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusShell}" FontSize="11" Margin="0,0,12,0" />
          <TextBlock Text="{Binding StatusConnection}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,12,0" />
          <TextBlock Text="{Binding StatusDirectory}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusLanguage}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,10,0"
                     Visibility="{Binding IsEditorTabSelected, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding StatusCursor}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,10,0"
                     Visibility="{Binding IsEditorTabSelected, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding StatusUser}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,10,0"
                     Visibility="{Binding IsEditorTabSelected, Converter={StaticResource BoolToVisInvert}}" />
          <TextBlock Text="{Binding StatusHost}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding StatusEncoding}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding StatusTerminalType}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,10,0" />
          <Button Content="Cancel" FontSize="10" Padding="8,1" Margin="0,0,4,0" Cursor="Hand"
                  Command="{Binding SelectedTerminalTab.CancelConnectCommand}"
                  Visibility="{Binding ShowCancelConnect, Converter={StaticResource BoolToVis}}"
                  ToolTip="Cancel in-progress connection"
                  Background="Transparent" Foreground="{DynamicResource BrushTextMuted}" BorderThickness="0" />
          <Button Content="Reconnect" FontSize="10" Padding="8,1" Margin="0,0,8,0" Cursor="Hand"
                  Command="{Binding SelectedTerminalTab.ReconnectCommand}"
                  Visibility="{Binding ShowReconnect, Converter={StaticResource BoolToVis}}"
                  ToolTip="Reconnect this terminal session"
                  Background="Transparent" Foreground="{DynamicResource BrushAccent}" BorderThickness="0" />
          <TextBlock Text="{Binding FontSize, StringFormat={}{0:0}px}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                     Visibility="{Binding IsEditorTabSelected, Converter={StaticResource BoolToVisInvert}}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
